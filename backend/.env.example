# Copy to backend/.env. Matches the development database in compose.yaml.
DATABASE_URL=postgres://gurow:gurow@127.0.0.1:5433/gurow
# Integration tests create, migrate and empty this separate database.
TEST_DATABASE_URL=postgres://gurow:gurow@127.0.0.1:5433/gurow_test
# Better Auth (ADR 0022): signs session cookies; generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Public origin the browser uses; the frontend forwards /api/* to this backend.
BETTER_AUTH_URL=http://localhost:3000
PORT=3001
