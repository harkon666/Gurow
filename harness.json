    "t06-l3-01-qualify": {"cwd": "frontend", "argv": ["bun", "run", "scripts/benchmark/qualify.ts", "--contract", "../docs/benchmarks/p1/protocol.json", "--out", "../.harness/t06/qualification"], "timeout": 600},
    "report-tests": {"cwd": "frontend", "argv": ["bun", "test", "scripts/benchmark/report.test.ts"], "timeout": 120},
